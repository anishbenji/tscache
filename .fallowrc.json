{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["packages/*/src/entries/*.ts"],
  "workspaces": {
    "packages": ["packages/*"]
  },
  // Consumed by tsdown's publint/attw integration, not imported anywhere.
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint"],
  "health": {
    // Test tables run long by design; size thresholds gate src only.
    "ignore": ["packages/*/test/**"]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {
    "unused-dependencies": "warn",
    // Members used only by tests or by a later commit-plan step are reported,
    // not gating: the import graph excludes tests, so they look unused.
    "unused-class-members": "warn"
  }
}
