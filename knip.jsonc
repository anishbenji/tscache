{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/tscache": {
      // bench/entry.ts and bench/e2e.ts are bundled by scripts/bench.ts and
      // scripts/bench-e2e.ts, not imported.
      "entry": [
        "src/entries/*.ts",
        "test/**/*.test.ts",
        "bench/entry.ts",
        "bench/e2e.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts"],
      // The tscache/vite test loads Vite through a computed specifier, so
      // its types (which bring Node's) stay out of the package's type check.
      // The bench bundle's revisions, resolved by scripts/bench.ts.
      "ignoreDependencies": ["vite", "tscache-bench"]
    },
    // The SSR examples' server entries are named only by their Vite config.
    "examples/react-ssr": { "entry": ["src/entry-server.tsx"] },
    "examples/solid-ssr": { "entry": ["src/entry-server.tsx"] },
    // The server-rendered page's entries, named by the Vite config and by
    // ssr.html (Knip reads index.html only).
    "reference/vanilla": {
      "entry": ["src/entry-server.ts", "src/entry-client.ts"]
    },
    "reference/react": {
      "entry": ["src/entry-server.tsx", "src/entry-client.tsx"]
    },
    "reference/solid": {
      "entry": ["src/entry-server.tsx", "src/entry-client.tsx"]
    },
    // The site's code examples: the pages include them as text, nothing
    // imports them; the snippet runner, which Bun runs.
    "site": { "entry": ["snippets/*.ts", "scripts/*.ts"] },
    // Every snippet is an entry: an app copies it, nothing imports it.
    "integrations": {
      "entry": ["*/*.{ts,tsx}", "test/**/*.test.ts"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  // Consumed by tsdown's attw integration, not imported anywhere.
  "ignoreDependencies": ["@arethetypeswrong/cli"],
  // A system tool the demo launcher's spec uses to find leftover servers.
  "ignoreBinaries": ["pgrep"]
}
