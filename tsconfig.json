{
  // The scripts Bun runs and the tool configs outside every other project.
  // The library, the examples, the integration snippets and e2e/ have
  // projects of their own; the frozen Bash guard stays unchecked.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "isolatedDeclarations": false,
    "declaration": false,
    // The Playwright backend encodes with the mock backend's columns module,
    // which imports tscache's types and nothing else. They are checked
    // against the source, since dist/ is built after the check, and against
    // the import-free types module alone: the client's source needs the DOM
    // library, which the Bun scripts here do not load.
    "paths": {
      "tscache": ["./packages/tscache/src/types.ts"]
    }
  },
  "include": ["scripts", "*.config.ts", "packages/*/tsdown.config.ts"]
}
