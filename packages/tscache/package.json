{
  "name": "@anishbenji/tscache",
  "version": "0.0.0",
  "description": "Browser time-series cache: SharedWorker multi-tab sharing, worker-side fetch orchestration, coverage tracking with real-gap awareness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishbenji/tscache.git",
    "directory": "packages/tscache"
  },
  "homepage": "https://github.com/anishbenji/tscache#readme",
  "bugs": {
    "url": "https://github.com/anishbenji/tscache/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./fetcher": {
      "types": "./dist/fetcher.d.ts",
      "default": "./dist/fetcher.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "keywords": [
    "time-series",
    "cache",
    "sharedworker",
    "ohlcv",
    "charts"
  ],
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
