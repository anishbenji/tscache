{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `bun run typecheck` runs before the build, and the package's exports
    // point into dist/: check against the source, as Vitest's alias does.
    "paths": {
      "tscache": ["../../packages/tscache/src/entries/index.ts"],
      "tscache/*": ["../../packages/tscache/src/entries/*.ts"]
    }
  },
  "include": ["src", "test"]
}
