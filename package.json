{
  "name": "tscache-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc -p packages/tscache",
    "test": "vitest run --passWithNoTests",
    "build": "bun run --filter tscache build",
    "knip": "knip",
    "fallow": "fallow audit",
    "changelog": "git-cliff -o CHANGELOG.md",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "fallow": "^3.31.0",
    "git-cliff": "^2.14.2",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "publint": "^0.3.25",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
