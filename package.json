{
  "name": "tscache-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "integrations",
    "reference/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc -p packages/tscache && tsc -p . && tsc -p e2e && tsc -p examples/mock-backend && tsc -p reference/shared",
    "check:integrations": "bun run --cwd integrations check",
    "test": "vitest run --passWithNoTests",
    "build": "bun run --filter tscache build",
    "knip": "knip",
    "fallow": "fallow audit",
    "changelog": "git-cliff -o CHANGELOG.md",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.4",
    "fallow": "^3.31.0",
    "git-cliff": "^2.14.2",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
