{
  "name": "tscache-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc -p packages/tscache",
    "test": "vitest run --passWithNoTests",
    "build": "bun run --filter tscache build",
    "knip": "knip",
    "changelog": "git-cliff -o CHANGELOG.md",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "git-cliff": "^2.13.1",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
