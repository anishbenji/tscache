{
  "name": "tscache-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "integrations",
    "reference/*",
    "site"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc -p packages/tscache && tsc -p . && tsc -p e2e && tsc -p examples/mock-backend && tsc -p reference/shared",
    "check:integrations": "bun run --cwd integrations check",
    "check:pack": "bun scripts/check-pack.ts",
    "docs:dev": "bun run --cwd site dev",
    "docs:build": "bun run --cwd site build",
    "docs:check": "tsc -p site && tsc -p site/scripts && bun site/scripts/module-graph.ts --check && bun site/scripts/check-doc-anchors.ts",
    "docs:run": "bun site/scripts/run-snippets.ts",
    "test": "vitest run --passWithNoTests",
    "build": "bun run --filter @anishbenji/tscache build",
    "knip": "knip",
    "fallow": "fallow audit",
    "fallow:health": "fallow health --min-score 90",
    "changelog": "git-cliff --unreleased --prepend CHANGELOG.md",
    "ci": "bash scripts/ci.sh",
    "demo": "bun scripts/demo.ts",
    "size": "bun scripts/size.ts",
    "bench": "bun scripts/bench.ts compare",
    "bench:smoke": "bun scripts/bench.ts smoke",
    "bench:e2e": "bun scripts/bench.ts e2e",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/bun": "^1.4.4",
    "fallow": "^3.37.0",
    "git-cliff": "^2.14.2",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
