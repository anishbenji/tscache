{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The package's exports point into dist/, which `bun run ci` builds
    // after the type check and pre-push rebuilds alongside it; the backend
    // checks against the source instead, as Vitest's alias does.
    "paths": {
      "tscache": ["../../packages/tscache/src/entries/index.ts"],
      "tscache/*": ["../../packages/tscache/src/entries/*.ts"]
    }
  },
  "include": ["src", "test"]
}
